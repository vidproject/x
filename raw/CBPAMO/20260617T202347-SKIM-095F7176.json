    {
      "tweet_id": "1970523860786389398",
      "account_handle": "CBPAMO",
      "account_id": "1184840877212143617",
      "posted_at": "2025-09-23T16:21:13.000Z",
      "first_captured_at": "2026-06-17T20:23:35.665Z",
