    {
      "tweet_id": "1931088838589329815",
      "account_handle": "USCG",
      "account_id": "15113565",
      "posted_at": "2025-06-06T20:40:31.000Z",
      "first_captured_at": "2026-06-17T20:54:10.998Z",
