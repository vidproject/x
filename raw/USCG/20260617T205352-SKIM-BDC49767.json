    {
      "tweet_id": "1927074701110575351",
      "account_handle": "USCG",
      "account_id": "15113565",
      "posted_at": "2025-05-26T18:49:46.000Z",
      "first_captured_at": "2026-06-17T20:53:41.657Z",
